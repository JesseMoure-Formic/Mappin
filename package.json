{
  "name": "mappin",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "npm run build:web && npm run build:server",
    "build:web": "expo export --platform web --output-dir web-build",
    "build:server": "npm --prefix server install && npm --prefix server run build",
    "serve": "node server/dist/index.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.7",
    "@expo/ngrok": "^4.1.3",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "expo": "~52.0.0",
    "expo-asset": "^55.0.10",
    "expo-font": "^55.0.4",
    "expo-location": "~18.0.0",
    "expo-modules-core": "^55.0.18",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-maps": "1.18.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
